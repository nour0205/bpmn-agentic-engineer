    <ns0:textAnnotation id="Id_51c7cee9-a762-42c1-8092-1038ec70ef92">
      <ns0:documentation />
      <ns0:extensionElements>
        <bizagi:BizagiExtensions>
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#D5D5D5" />
            <bizagi:BizagiProperty name="borderColor" value="#D5D5D5" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </ns0:extensionElements>
      <ns0:text>Sur la base d'un modèle pré-définis intégrant des données statiques et dynamiques</ns0:text>
    </ns0:textAnnotation>
    <ns0:textAnnotation id="Id_411f66aa-6028-4ec0-ac51-bbb6b5d0818e">
      <ns0:documentation />
      <ns0:extensionElements>
        <bizagi:BizagiExtensions>
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#D5D5D5" />
            <bizagi:BizagiProperty name="borderColor" value="#D5D5D5" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </ns0:extensionElements>
      <ns0:text>Il est possible de filtrer les commandes par date, produit, etc.</ns0:text>
    </ns0:textAnnotation>
    <ns0:textAnnotation id="Id_a0371300-e98f-4741-90fd-5e848a644e16">
      <ns0:documentation />
      <ns0:extensionElements>
        <bizagi:BizagiExtensions>
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#D5D5D5" />
            <bizagi:BizagiProperty name="borderColor" value="#D5D5D5" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </ns0:extensionElements>
      <ns0:text>Avec une possibilité de consulter le reliquat de livraison, le statut, etc.</ns0:text>
    </ns0:textAnnotation>
