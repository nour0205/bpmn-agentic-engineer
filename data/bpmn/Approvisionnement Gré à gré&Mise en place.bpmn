      </extensionElements>
      <text>Ceci permettra un accès aux PV de la CAM en temps réel </text>
    </textAnnotation>
    <textAnnotation id="Id_3e52dbff-9f11-4978-b7a4-7ccb05b20201">
      <documentation />
      <extensionElements>
