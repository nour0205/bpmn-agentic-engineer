      <text>sur l'article fini</text>
    </textAnnotation>
    <textAnnotation id="Id_62ec4691-6a37-4b1a-a381-c6be45fdf64b">
      <documentation />
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
