            <bizagi:BizagiProperty name="textDirection" value="" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <text>Le système GED est interfacé avec le SI</text>
    </textAnnotation>
    <textAnnotation id="Id_91aad3de-d5e9-4bda-b971-a7f5e05f4adb">
      <documentation />
      <extensionElements>
